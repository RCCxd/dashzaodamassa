# Firebase Web config — valores públicos da aplicação web cadastrada no Firebase.
# Use as mesmas variáveis no Vercel (Preview e Production). Nunca coloque service-account JSON aqui.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# UID da conta admin criada manualmente em Firebase Console > Authentication > Users.
# Também substitua REPLACE_WITH_ADMIN_UID em firestore.rules pelo mesmo UID antes de publicar as regras.
VITE_FIREBASE_ADMIN_UID=
