{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["api/**/*.ts"],
  "exclude": ["node_modules", "client", "server", "drizzle", "scripts"]
}
