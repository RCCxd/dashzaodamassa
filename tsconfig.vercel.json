{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true
  },
  "include": ["client/src/**/*.ts", "client/src/**/*.tsx", "vite.config.ts"],
  "exclude": ["node_modules", "server", "api", "drizzle", "scripts"]
}
