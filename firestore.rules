rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Substitua o marcador pelo UID da conta administrativa criada no Console Firebase.
    // Se esquecer, nenhum usuário terá permissão administrativa.
    function isAdmin() {
      return signedIn() && request.auth.uid == "OnUYUaC8B8Nnpkh679DWAspK7392";
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isOptionalString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function validProfile(uid) {
      return request.resource.data.keys().hasOnly(["uid", "name", "email", "role", "createdAt", "updatedAt"])
        && request.resource.data.keys().hasAll(["uid", "name", "email", "role"])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.role == (isAdmin() ? "admin" : "student");
    }

    function validSubject() {
      return request.resource.data.keys().hasOnly(["name", "color", "teacher", "schedule", "description", "archived", "archivedAt", "createdAt", "updatedAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.color is string
        && request.resource.data.color.size() <= 16
        && isOptionalString(request.resource.data.teacher, 120)
        && isOptionalString(request.resource.data.schedule, 160)
        && isOptionalString(request.resource.data.description, 2000)
        && request.resource.data.get("archived", false) is bool
        && (request.resource.data.get("archived", false)
          ? request.resource.data.get("archivedAt", null) is timestamp
          : request.resource.data.get("archivedAt", null) == null);
    }

    function validActivity() {
      let subjectPath = /databases/$(database)/documents/subjects/$(request.resource.data.subjectId);
      return request.resource.data.keys().hasOnly(["subjectId", "title", "description", "type", "priority", "status", "dueDate", "resourceUrl", "attachmentPath", "attachmentName", "attachmentSize", "estimatedMinutes", "archived", "archivedAt", "createdAt", "updatedAt"])
        && request.resource.data.subjectId is string
        && exists(subjectPath)
        && get(subjectPath).data.get("archived", false) != true
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 180
        && isOptionalString(request.resource.data.description, 5000)
        && request.resource.data.type in ["tarefa", "prova", "trabalho", "projeto"]
        && request.resource.data.priority in ["baixa", "media", "alta"]
        && request.resource.data.status in ["pendente", "em_andamento", "concluida"]
        && (request.resource.data.dueDate == null || request.resource.data.dueDate is timestamp)
        && isOptionalString(request.resource.data.resourceUrl, 2048)
        && isOptionalString(request.resource.data.attachmentPath, 512)
        && isOptionalString(request.resource.data.attachmentName, 180)
        && (request.resource.data.attachmentSize == null || (request.resource.data.attachmentSize is int && request.resource.data.attachmentSize >= 1 && request.resource.data.attachmentSize <= 10485760))
        && request.resource.data.estimatedMinutes is int
        && request.resource.data.estimatedMinutes >= 1
        && request.resource.data.estimatedMinutes <= 1440
        && request.resource.data.get("archived", false) is bool
        && (request.resource.data.get("archived", false)
          ? request.resource.data.get("archivedAt", null) is timestamp
          : request.resource.data.get("archivedAt", null) == null);
    }

    function isActiveSubject(subjectId) {
      return subjectId is string
        && exists(/databases/$(database)/documents/subjects/$(subjectId))
        && get(/databases/$(database)/documents/subjects/$(subjectId)).data.get("archived", false) != true;
    }

    function activityPoints(priority, activityType) {
      let priorityPoints = 10 + (priority == "alta" ? 5 : priority == "media" ? 2 : 0);
      let typeBonus = activityType == "prova" ? 5 : activityType == "trabalho" ? 3 : activityType == "projeto" ? 4 : 0;
      return priorityPoints + typeBonus;
    }

    function ledgerIsActive(data) {
      return !data.keys().hasAll(["active"]) || data.active == true;
    }

    function subtractRP(totalRP, points) {
      return totalRP >= points ? totalRP - points : 0;
    }

    function activityDeadline(activityId) {
      let activityPath = /databases/$(database)/documents/activities/$(activityId);
      let dueDate = exists(activityPath) ? get(activityPath).data.get("dueDate", null) : null;
      return dueDate is timestamp ? dueDate + duration.value(12, "h") : null;
    }

    function activityIsPastDeadline(activityId) {
      let deadline = activityDeadline(activityId);
      return deadline is timestamp && request.time > deadline;
    }

    function newLatePenaltyLoss(uid, activityId) {
      let penaltyPath = /databases/$(database)/documents/users/$(uid)/latePenalties/$(activityId);
      return existsAfter(penaltyPath) && !exists(penaltyPath) ? getAfter(penaltyPath).data.lostRP : 0;
    }

    function expectedRPAfterAward(uid, activityId, oldTotal, oldPoints, newPoints, reverseOld) {
      let baseRP = reverseOld ? subtractRP(oldTotal, oldPoints) : oldTotal;
      return subtractRP(baseRP, newLatePenaltyLoss(uid, activityId)) + newPoints;
    }

    function validLateCompletion(uid, activityId) {
      let penaltyPath = /databases/$(database)/documents/users/$(uid)/latePenalties/$(activityId);
      return !activityIsPastDeadline(activityId) || existsAfter(penaltyPath);
    }

    function validLatePenaltyState(uid, activityId, totalAfter) {
      let penaltyPath = /databases/$(database)/documents/users/$(uid)/latePenalties/$(activityId);
      let statePath = /databases/$(database)/documents/users/$(uid)/ranking/state;
      let completionPath = /databases/$(database)/documents/users/$(uid)/activityCompletions/$(activityId);
      let ledgerPath = /databases/$(database)/documents/users/$(uid)/rankedActivities/$(activityId);
      let totalBefore = exists(statePath) ? get(statePath).data.totalRP : 0;
      let lostRP = existsAfter(penaltyPath) ? getAfter(penaltyPath).data.lostRP : 0;
      let earnedRP = !exists(completionPath) && existsAfter(completionPath) && existsAfter(ledgerPath) ? getAfter(ledgerPath).data.points : 0;
      let expectedTotal = subtractRP(totalBefore, lostRP) + earnedRP;
      return existsAfter(penaltyPath)
        && !exists(penaltyPath)
        && existsAfter(statePath)
        && (!existsAfter(completionPath) || (existsAfter(ledgerPath) && getAfter(ledgerPath).data.active == true))
        && getAfter(statePath).data.lastActivityId == activityId
        && totalAfter == expectedTotal
        && publicRankIsSynced(uid, expectedTotal);
    }

    function publicRankIsSynced(uid, totalRP) {
      let settingsPath = /databases/$(database)/documents/users/$(uid)/ranking/settings;
      let publicPath = /databases/$(database)/documents/leaderboard/$(uid);
      return !exists(settingsPath)
        || get(settingsPath).data.visible != true
        || (existsAfter(publicPath)
          && getAfter(publicPath).data.totalRP == totalRP
          && getAfter(publicPath).data.displayName == get(settingsPath).data.publicName);
    }

    function validScheduleSlot() {
      let subjectPath = /databases/$(database)/documents/subjects/$(request.resource.data.subjectId);
      return request.resource.data.keys().hasOnly(["subjectId", "day", "startTime", "endTime", "room", "createdAt", "updatedAt"])
        && request.resource.data.keys().hasAll(["subjectId", "day", "startTime", "endTime", "room", "createdAt", "updatedAt"])
        && request.resource.data.subjectId is string
        && existsAfter(subjectPath)
        && getAfter(subjectPath).data.get("archived", false) != true
        && request.resource.data.day is int
        && request.resource.data.day >= 1
        && request.resource.data.day <= 5
        && request.resource.data.startTime is string
        && request.resource.data.startTime.matches("^([01][0-9]|2[0-3]):[0-5][0-9]$")
        && request.resource.data.endTime is string
        && request.resource.data.endTime.matches("^([01][0-9]|2[0-3]):[0-5][0-9]$")
        && request.resource.data.startTime < request.resource.data.endTime
        && isOptionalString(request.resource.data.room, 80)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time;
    }

    function validRankAwardState(uid, activityId, oldTotal, oldPoints, oldActive, newPoints, totalAfter) {
      let ledgerPath = /databases/$(database)/documents/users/$(uid)/rankedActivities/$(activityId);
      let completionPath = /databases/$(database)/documents/users/$(uid)/activityCompletions/$(activityId);
      let activityPath = /databases/$(database)/documents/activities/$(activityId);
      return existsAfter(completionPath)
        && exists(activityPath)
        && (exists(completionPath)
          || (get(activityPath).data.get("archived", false) != true
            && isActiveSubject(get(activityPath).data.subjectId)
            && validLateCompletion(uid, activityId)))
        && getAfter(ledgerPath).data.active == true
        && newPoints == activityPoints(get(activityPath).data.get("priority", "media"), get(activityPath).data.get("type", "tarefa"))
        && (exists(completionPath)
          ? get(completionPath).data.activityId == activityId && get(completionPath).data.completedAt is timestamp
          : getAfter(completionPath).data.activityId == activityId && getAfter(completionPath).data.completedAt == request.time)
        && (((!exists(ledgerPath) || !oldActive)
            && totalAfter == expectedRPAfterAward(uid, activityId, oldTotal, oldPoints, newPoints, false))
          || (exists(ledgerPath) && oldActive && !exists(completionPath)
            && totalAfter == expectedRPAfterAward(uid, activityId, oldTotal, oldPoints, newPoints, true)));
    }

    function validRankActivityState(uid, activityId, oldTotal, oldPoints, oldActive, newPoints, totalAfter) {
      let ledgerPath = /databases/$(database)/documents/users/$(uid)/rankedActivities/$(activityId);
      let completionPath = /databases/$(database)/documents/users/$(uid)/activityCompletions/$(activityId);
      return existsAfter(ledgerPath)
        && getAfter(ledgerPath).data.activityId == activityId
        && (validRankAwardState(uid, activityId, oldTotal, oldPoints, oldActive, newPoints, totalAfter)
          || (!existsAfter(completionPath)
            && exists(ledgerPath)
            && oldActive
            && getAfter(ledgerPath).data.active == false
            && getAfter(ledgerPath).data.points == oldPoints
            && totalAfter == subtractRP(oldTotal, oldPoints)));
    }

    function validRankState(uid) {
      let activityId = request.resource.data.lastActivityId;
      let statePath = /databases/$(database)/documents/users/$(uid)/ranking/state;
      let ledgerPath = /databases/$(database)/documents/users/$(uid)/rankedActivities/$(activityId);
      let oldTotal = exists(statePath) ? get(statePath).data.totalRP : 0;
      let oldPoints = exists(ledgerPath) ? get(ledgerPath).data.points : 0;
      let oldActive = exists(ledgerPath) && ledgerIsActive(get(ledgerPath).data);
      let totalAfter = request.resource.data.totalRP;
      let newPoints = existsAfter(ledgerPath) ? getAfter(ledgerPath).data.points : 0;
      return request.resource.data.keys().hasOnly(["totalRP", "lastActivityId", "updatedAt"])
        && request.resource.data.keys().hasAll(["totalRP", "lastActivityId", "updatedAt"])
        && request.resource.data.totalRP is int
        && totalAfter >= 0
        && request.resource.data.updatedAt == request.time
        && ((activityId == null && totalAfter == 0 && !exists(statePath))
          || (activityId is string
            && publicRankIsSynced(uid, totalAfter)
            && (validRankActivityState(uid, activityId, oldTotal, oldPoints, oldActive, newPoints, totalAfter)
              || validLatePenaltyState(uid, activityId, totalAfter))));
    }

    function validRankSettings(uid) {
      let statePath = /databases/$(database)/documents/users/$(uid)/ranking/state;
      let publicPath = /databases/$(database)/documents/leaderboard/$(uid);
      return request.resource.data.keys().hasOnly(["publicName", "visible", "updatedAt"])
        && request.resource.data.keys().hasAll(["publicName", "visible", "updatedAt"])
        && request.resource.data.publicName is string
        && request.resource.data.publicName.size() >= 2
        && request.resource.data.publicName.size() <= 32
        && request.resource.data.visible is bool
        && request.resource.data.updatedAt == request.time
        && existsAfter(statePath)
        && (request.resource.data.visible
          ? existsAfter(publicPath)
            && getAfter(publicPath).data.displayName == request.resource.data.publicName
            && getAfter(publicPath).data.totalRP == getAfter(statePath).data.totalRP
          : !existsAfter(publicPath));
    }

    function validPublicRank(uid) {
      let settingsPath = /databases/$(database)/documents/users/$(uid)/ranking/settings;
      let statePath = /databases/$(database)/documents/users/$(uid)/ranking/state;
      return request.resource.data.keys().hasOnly(["displayName", "totalRP", "updatedAt"])
        && request.resource.data.keys().hasAll(["displayName", "totalRP", "updatedAt"])
        && request.resource.data.displayName is string
        && request.resource.data.totalRP is int
        && request.resource.data.totalRP >= 0
        && request.resource.data.updatedAt == request.time
        && existsAfter(settingsPath)
        && getAfter(settingsPath).data.visible == true
        && request.resource.data.displayName == getAfter(settingsPath).data.publicName
        && existsAfter(statePath)
        && request.resource.data.totalRP == getAfter(statePath).data.totalRP;
    }

    function validRankLedgerCreate(uid, activityId) {
      let activityPath = /databases/$(database)/documents/activities/$(activityId);
      let ledgerPath = /databases/$(database)/documents/users/$(uid)/rankedActivities/$(activityId);
      let completionPath = /databases/$(database)/documents/users/$(uid)/activityCompletions/$(activityId);
      let statePath = /databases/$(database)/documents/users/$(uid)/ranking/state;
      let stateBefore = exists(statePath) ? get(statePath).data.totalRP : 0;
      return request.resource.data.keys().hasOnly(["activityId", "points", "awardedAt", "active", "reversedAt"])
        && request.resource.data.keys().hasAll(["activityId", "points", "awardedAt", "active", "reversedAt"])
        && request.resource.data.activityId == activityId
        && exists(activityPath)
        && (exists(completionPath)
          || (get(activityPath).data.get("archived", false) != true
            && isActiveSubject(get(activityPath).data.subjectId)))
        && request.resource.data.points is int
        && request.resource.data.points == activityPoints(get(activityPath).data.get("priority", "media"), get(activityPath).data.get("type", "tarefa"))
        && request.resource.data.awardedAt == request.time
        && request.resource.data.active == true
        && request.resource.data.reversedAt == null
        && !exists(ledgerPath)
        && existsAfter(completionPath)
        && (exists(completionPath)
          ? get(completionPath).data.activityId == activityId && get(completionPath).data.completedAt is timestamp
          : getAfter(completionPath).data.activityId == activityId && getAfter(completionPath).data.completedAt == request.time)
        && existsAfter(statePath)
        && getAfter(statePath).data.lastActivityId == activityId
        && getAfter(statePath).data.totalRP == expectedRPAfterAward(uid, activityId, stateBefore, 0, request.resource.data.points, false)
        && publicRankIsSynced(uid, getAfter(statePath).data.totalRP);
    }

    function validRankLedgerUpdate(uid, activityId) {
      let activityPath = /databases/$(database)/documents/activities/$(activityId);
      let ledgerPath = /databases/$(database)/documents/users/$(uid)/rankedActivities/$(activityId);
      let completionPath = /databases/$(database)/documents/users/$(uid)/activityCompletions/$(activityId);
      let statePath = /databases/$(database)/documents/users/$(uid)/ranking/state;
      let stateBefore = exists(statePath) ? get(statePath).data.totalRP : 0;
      let oldActive = ledgerIsActive(resource.data);
      let oldPoints = resource.data.points;
      let staleTotal = subtractRP(stateBefore, oldPoints);
      return request.resource.data.keys().hasOnly(["activityId", "points", "awardedAt", "active", "reversedAt"])
        && request.resource.data.keys().hasAll(["activityId", "points", "awardedAt", "active", "reversedAt"])
        && request.resource.data.activityId == activityId
        && request.resource.data.points is int
        && request.resource.data.points >= 0
        && ((oldActive
          && request.resource.data.active == false
          && request.resource.data.points == oldPoints
          && request.resource.data.awardedAt == resource.data.awardedAt
          && request.resource.data.reversedAt == request.time
          && !existsAfter(completionPath)
          && existsAfter(statePath)
          && getAfter(statePath).data.lastActivityId == activityId
          && getAfter(statePath).data.totalRP == staleTotal
          && publicRankIsSynced(uid, staleTotal))
          || (!oldActive
            && request.resource.data.active == true
            && exists(activityPath)
            && (exists(completionPath)
              || (get(activityPath).data.get("archived", false) != true
                && isActiveSubject(get(activityPath).data.subjectId)))
            && request.resource.data.points == activityPoints(get(activityPath).data.get("priority", "media"), get(activityPath).data.get("type", "tarefa"))
            && request.resource.data.awardedAt == request.time
            && request.resource.data.reversedAt == null
            && existsAfter(completionPath)
            && (exists(completionPath)
              ? get(completionPath).data.activityId == activityId && get(completionPath).data.completedAt is timestamp
              : getAfter(completionPath).data.activityId == activityId && getAfter(completionPath).data.completedAt == request.time)
            && existsAfter(statePath)
            && getAfter(statePath).data.lastActivityId == activityId
            && getAfter(statePath).data.totalRP == expectedRPAfterAward(uid, activityId, stateBefore, 0, request.resource.data.points, false)
            && publicRankIsSynced(uid, getAfter(statePath).data.totalRP))
          || (oldActive
            && request.resource.data.active == true
            && exists(activityPath)
            && get(activityPath).data.get("archived", false) != true
            && isActiveSubject(get(activityPath).data.subjectId)
            && request.resource.data.points == activityPoints(get(activityPath).data.get("priority", "media"), get(activityPath).data.get("type", "tarefa"))
            && request.resource.data.awardedAt == request.time
            && request.resource.data.reversedAt == null
            && !exists(completionPath)
            && existsAfter(completionPath)
            && existsAfter(statePath)
            && getAfter(statePath).data.lastActivityId == activityId
            && getAfter(statePath).data.totalRP == expectedRPAfterAward(uid, activityId, stateBefore, oldPoints, request.resource.data.points, true)
            && publicRankIsSynced(uid, getAfter(statePath).data.totalRP)));
    }

    function validRankCompletionCreate(uid, activityId) {
      let activityPath = /databases/$(database)/documents/activities/$(activityId);
      let ledgerPath = /databases/$(database)/documents/users/$(uid)/rankedActivities/$(activityId);
      let statePath = /databases/$(database)/documents/users/$(uid)/ranking/state;
      let ledgerExists = exists(ledgerPath);
      let oldActive = ledgerExists && ledgerIsActive(get(ledgerPath).data);
      let stateBefore = exists(statePath) ? get(statePath).data.totalRP : 0;
      let oldPoints = ledgerExists ? get(ledgerPath).data.points : 0;
      return request.resource.data.keys().hasOnly(["activityId", "completedAt"])
        && request.resource.data.activityId == activityId
        && request.resource.data.completedAt == request.time
        && exists(activityPath)
        && get(activityPath).data.get("archived", false) != true
        && get(activityPath).data.status != "concluida"
        && isActiveSubject(get(activityPath).data.subjectId)
        && validLateCompletion(uid, activityId)
        && existsAfter(ledgerPath)
        && getAfter(ledgerPath).data.active == true
        && getAfter(ledgerPath).data.points == activityPoints(get(activityPath).data.get("priority", "media"), get(activityPath).data.get("type", "tarefa"))
        && existsAfter(statePath)
        && getAfter(statePath).data.lastActivityId == activityId
        && ((!ledgerExists || !oldActive)
          ? getAfter(statePath).data.totalRP == expectedRPAfterAward(uid, activityId, stateBefore, oldPoints, getAfter(ledgerPath).data.points, false)
          : getAfter(statePath).data.totalRP == expectedRPAfterAward(uid, activityId, stateBefore, oldPoints, getAfter(ledgerPath).data.points, true))
        && publicRankIsSynced(uid, getAfter(statePath).data.totalRP);
    }

    function validRankCompletionDelete(uid, activityId) {
      let ledgerPath = /databases/$(database)/documents/users/$(uid)/rankedActivities/$(activityId);
      let statePath = /databases/$(database)/documents/users/$(uid)/ranking/state;
      let stateBefore = exists(statePath) ? get(statePath).data.totalRP : 0;
      let ledgerActive = exists(ledgerPath) && ledgerIsActive(get(ledgerPath).data);
      let points = exists(ledgerPath) ? get(ledgerPath).data.points : 0;
      let totalAfter = subtractRP(stateBefore, points);
      return !ledgerActive
        || (existsAfter(ledgerPath)
          && getAfter(ledgerPath).data.active == false
          && existsAfter(statePath)
          && getAfter(statePath).data.lastActivityId == activityId
          && getAfter(statePath).data.updatedAt == request.time
          && getAfter(statePath).data.totalRP == totalAfter
          && publicRankIsSynced(uid, totalAfter));
    }

    function validLatePenaltyCreate(uid, activityId) {
      let activityPath = /databases/$(database)/documents/activities/$(activityId);
      let penaltyPath = /databases/$(database)/documents/users/$(uid)/latePenalties/$(activityId);
      let completionPath = /databases/$(database)/documents/users/$(uid)/activityCompletions/$(activityId);
      let statePath = /databases/$(database)/documents/users/$(uid)/ranking/state;
      let deadline = activityDeadline(activityId);
      let totalBefore = exists(statePath) ? get(statePath).data.totalRP : 0;
      let expectedLoss = totalBefore >= 5 ? 5 : totalBefore;
      let totalAfter = existsAfter(statePath) ? getAfter(statePath).data.totalRP : 0;
      return !isAdmin()
        && request.resource.data.keys().hasOnly(["activityId", "penaltyRP", "lostRP", "dueAt", "penalizedAt"])
        && request.resource.data.keys().hasAll(["activityId", "penaltyRP", "lostRP", "dueAt", "penalizedAt"])
        && request.resource.data.activityId == activityId
        && request.resource.data.penaltyRP == 5
        && request.resource.data.lostRP is int
        && request.resource.data.lostRP == expectedLoss
        && request.resource.data.dueAt == deadline
        && request.resource.data.penalizedAt == request.time
        && !exists(penaltyPath)
        && (!exists(completionPath)
          || (get(completionPath).data.completedAt is timestamp && get(completionPath).data.completedAt > deadline))
        && exists(activityPath)
        && get(activityPath).data.get("archived", false) != true
        && get(activityPath).data.status != "concluida"
        && isActiveSubject(get(activityPath).data.subjectId)
        && deadline is timestamp
        && request.time > deadline
        && (!existsAfter(completionPath)
          || (getAfter(completionPath).data.activityId == activityId && getAfter(completionPath).data.completedAt == request.time))
        && validLatePenaltyState(uid, activityId, totalAfter);
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid) && validProfile(uid);
      allow update: if (isAdmin() && validProfile(uid))
        || (owns(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "updatedAt"])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email);
      allow delete: if false;

      match /activityCompletions/{activityId} {
        allow read: if owns(uid);
        allow create: if owns(uid) && validRankCompletionCreate(uid, activityId);
        allow update: if false;
        allow delete: if owns(uid) && validRankCompletionDelete(uid, activityId);
      }

      match /studySessions/{sessionId} {
        allow read: if owns(uid);
        allow create: if owns(uid)
          && request.resource.data.keys().hasOnly(["durationMinutes", "subjectId", "activityId", "kind", "startedAt", "completedAt"])
          && request.resource.data.durationMinutes is int
          && request.resource.data.durationMinutes >= 1
          && request.resource.data.durationMinutes <= 600
          && (request.resource.data.subjectId == null || request.resource.data.subjectId is string)
          && (request.resource.data.activityId == null || request.resource.data.activityId is string)
          && request.resource.data.kind in ["pomodoro", "livre"]
          && request.resource.data.startedAt is timestamp
          && request.resource.data.completedAt == request.time;
        allow update, delete: if false;
      }

      match /planner/{noteId} {
        allow read: if owns(uid);
        allow create, update: if owns(uid)
          && noteId == "quickNote"
          && request.resource.data.keys().hasOnly(["content", "updatedAt"])
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 5000
          && request.resource.data.updatedAt == request.time;
        allow delete: if owns(uid);
      }

      match /weeklyGoals/{weekStart} {
        allow read: if owns(uid);
        allow create, update: if owns(uid)
          && request.resource.data.keys().hasOnly(["weekStart", "targetMinutes", "targetSessions", "updatedAt"])
          && request.resource.data.weekStart == weekStart
          && weekStart.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
          && request.resource.data.targetMinutes is int
          && request.resource.data.targetMinutes >= 15
          && request.resource.data.targetMinutes <= 2400
          && request.resource.data.targetSessions is int
          && request.resource.data.targetSessions >= 1
          && request.resource.data.targetSessions <= 50
          && request.resource.data.updatedAt == request.time;
        allow delete: if owns(uid);
      }

      match /preferences/{preferenceId} {
        allow read: if owns(uid);
        allow create, update: if owns(uid)
          && preferenceId == "visual"
          && request.resource.data.keys().hasOnly(["accent", "surface", "texture", "density", "updatedAt"])
          && request.resource.data.keys().hasAll(["accent", "surface", "texture", "density", "updatedAt"])
          && request.resource.data.accent in ["lime", "indigo", "coral", "violet"]
          && request.resource.data.surface in ["graphite", "ink", "plum"]
          && request.resource.data.texture in ["plain", "grid"]
          && request.resource.data.density in ["comfortable", "compact"]
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /ranking/{rankingDocument} {
        allow read: if owns(uid);
        allow create, update: if owns(uid)
          && rankingDocument == "state"
          && validRankState(uid);
        allow delete: if false;
      }

      match /ranking/{rankingDocument} {
        allow read: if owns(uid);
        allow create, update: if owns(uid)
          && rankingDocument == "settings"
          && validRankSettings(uid);
        allow delete: if false;
      }

      match /rankedActivities/{activityId} {
        allow read: if owns(uid);
        allow create: if owns(uid) && validRankLedgerCreate(uid, activityId);
        allow update: if owns(uid) && validRankLedgerUpdate(uid, activityId);
        allow delete: if false;
      }

      match /latePenalties/{activityId} {
        allow read: if owns(uid);
        allow create: if owns(uid) && validLatePenaltyCreate(uid, activityId);
        allow update, delete: if false;
      }
    }

    match /subjects/{subjectId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validSubject();
      allow delete: if false;
    }

    match /activities/{activityId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validActivity();
      allow delete: if false;
    }

    match /subjectSchedule/{slotId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validScheduleSlot();
      allow delete: if isAdmin();
    }

    match /leaderboard/{uid} {
      allow read: if signedIn();
      allow create, update: if owns(uid) && validPublicRank(uid);
      allow delete: if owns(uid)
        && existsAfter(/databases/$(database)/documents/users/$(uid)/ranking/settings)
        && getAfter(/databases/$(database)/documents/users/$(uid)/ranking/settings).data.visible == false;
    }

    // The client does not trust achievement writes; achievements are derived from a user's own records.
    // This collection is reserved for an optional later server-side implementation.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
